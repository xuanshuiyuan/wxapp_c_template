# ── 生产环境 ──────────────────────────────────────────────
# npm run build:* 时自动加载，优先级低于 .env.local
#
# REPLACE_API_BASE_URL / REPLACE_OSS_BASE_URL 由 init.sh 询问后替换；
# 跳过则保留占位，上线前必须手动替换（grep -rn 'REPLACE_'）。

VITE_APP_ENV=production

# 接口地址（H5 与后端同域时留空走相对路径；小程序/App 必填）
VITE_HOST_MP=REPLACE_API_BASE_URL
VITE_HOST_H5=REPLACE_API_BASE_URL
VITE_HOST_APP=REPLACE_API_BASE_URL
VITE_OSS_HOST=REPLACE_OSS_BASE_URL

# 生产环境禁止带 develop 头（后端 DevelopBypass=false）
# VITE_DEVELOP_BYPASS=

# 签名密钥不进 git（后端线下发放）：VITE_API_KEY 写在 .env.production.local