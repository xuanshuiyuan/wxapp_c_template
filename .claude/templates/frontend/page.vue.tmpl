<!-- ============================================================ -->
<!-- 页面模板（uni-app + Vue3 + uview-plus） -->
<!-- 说明：页面只负责渲染和事件响应，业务逻辑在 api/composables/services 中 -->
<!-- ============================================================ -->

<template>
  <view class="page">
    <!-- 顶部筛选区 -->
    <view class="card">
      <scroll-view class="chip-scroll" scroll-x>
        <view
          v-for="item in filterOptions"
          :key="item.value"
          class="chip"
          :class="{ 'chip--on': currentFilter === item.value }"
          @click="handleFilter(item.value)"
        >
          {{ item.label }}
        </view>
      </scroll-view>
    </view>

    <!-- 列表状态区：骨架屏 → 空态 → 失败重试 → 列表 -->
    <app-list-state
      :first-loading="firstLoading"
      :empty="isEmpty"
      :error="error"
      :loading="loading"
      :finished="finished"
      @retry="reload"
    />

    <!-- 列表内容 -->
    <view v-if="!firstLoading && !isEmpty" class="list">
      <view
        v-for="item in items"
        :key="item.id"
        class="list-item list-item--hover"
        @click="handleItemClick(item)"
      >
        <view class="list-item__main">
          <text class="t-h3">{{ item.name }}</text>
          <text class="t-desc mt-8">{{ item.description }}</text>
        </view>
        <view class="list-item__aside">
          <text class="c-primary">{{ item.statusText }}</text>
        </view>
      </view>

      <!-- 加载更多 / 到底 -->
      <view v-if="loading || finished" class="more">
        <text v-if="loading">加载中...</text>
        <text v-else-if="finished">没有更多了</text>
      </view>
    </view>

    <!-- 全局弹窗容器 -->
    <app-modal />
  </view>
</template>

<script>
import { ref } from 'vue';
import { useList } from '@/composables/useList';
import { {{domainName}}Api } from '@/api/{{domainFile}}';
import { route } from '@/services/route';

// 筛选选项，建议放到 config/dict.js 中统一管理
const FILTER_OPTIONS = [
  { label: '全部', value: 0 },
  { label: '进行中', value: 1 },
  { label: '已完成', value: 2 },
];

export default {
  setup() {
    // 当前筛选条件，响应式
    const currentFilter = ref(0);

    // 使用 useList 统一处理分页、下拉刷新、触底加载
    // 参数说明：fetcher 是返回 Promise 的接口方法；params 是返回当前参数的函数
    const {
      items,
      loading,
      refreshing,
      finished,
      error,
      isEmpty,
      firstLoading,
      reload,
      refresh,
      loadMore,
    } = useList({{domainName}}Api.list, {
      pageSize: 20,
      // 后端字段特殊时在这里覆写
      pageNumKey: 'page',
      pageSizeKey: 'page_size',
      // params 必须是函数，确保每次请求拿到最新筛选条件
      params: () => ({
        status: currentFilter.value,
      }),
    });

    // 切换筛选条件时重载列表
    const handleFilter = (value) => {
      if (currentFilter.value === value) return;
      currentFilter.value = value;
      reload();
    };

    // 点击列表项跳转详情
    const handleItemClick = (item) => {
      route.to('/pages/{{domainFile}}/detail', { id: item.id });
    };

    return {
      filterOptions: FILTER_OPTIONS,
      currentFilter,
      items,
      loading,
      refreshing,
      finished,
      error,
      isEmpty,
      firstLoading,
      reload,
      refresh,
      loadMore,
      handleFilter,
      handleItemClick,
    };
  },
};
</script>

<style lang="scss" scoped>
// 页面私有样式：只写该页独有的结构，通用样式走 scaffold.scss / 原子类
.list {
  padding: 0 24rpx;
}

.list-item__main {
  flex: 1;
}

.list-item__aside {
  margin-left: 16rpx;
}
</style>
