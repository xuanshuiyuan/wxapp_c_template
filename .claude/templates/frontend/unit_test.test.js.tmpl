// ============================================================
// 前端单元测试模板（uni-app + Vue3 + Vitest）
// 说明：测试 composables / 工具函数，覆盖正常、异常、边界场景
// ============================================================

import { describe, it, expect, vi, beforeEach } from 'vitest';
import { useList } from '@/composables/useList';

// 模拟 uni 环境
global.uni = {
  showLoading: vi.fn(),
  hideLoading: vi.fn(),
  stopPullDownRefresh: vi.fn(),
};

describe('useList', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it('正常情况_首次加载应请求第一页', async () => {
    const fetcher = vi.fn().mockResolvedValue({
      code: 0,
      data: { list: [{ id: 1, name: 'item' }], total: 1 },
    });

    const { items, reload } = useList(fetcher, { pageSize: 10 });
    await reload();

    expect(fetcher).toHaveBeenCalledWith({ page: 1, page_size: 10 });
    expect(items.value).toHaveLength(1);
    expect(items.value[0].name).toBe('item');
  });

  it('边界情况_空列表应标记为空态', async () => {
    const fetcher = vi.fn().mockResolvedValue({
      code: 0,
      data: { list: [], total: 0 },
    });

    const { isEmpty, reload } = useList(fetcher);
    await reload();

    expect(isEmpty.value).toBe(true);
  });

  it('异常情况_接口失败应记录错误', async () => {
    const fetcher = vi.fn().mockRejectedValue(new Error('network error'));

    const { error, reload } = useList(fetcher, { toastOnError: false });
    await reload();

    expect(error.value).toBeTruthy();
  });

  it('边界情况_pageSize为0_应使用默认值', async () => {
    const fetcher = vi.fn().mockResolvedValue({
      code: 0,
      data: { list: [], total: 0 },
    });

    const { reload } = useList(fetcher, { pageSize: 0 });
    await reload();

    const callArgs = fetcher.mock.calls[0][0];
    expect(callArgs.page_size).toBeGreaterThan(0);
  });
});
