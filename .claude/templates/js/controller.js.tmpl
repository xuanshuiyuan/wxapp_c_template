// ============================================================
// Controller / Handler 模板（Node.js / Express / Koa）
// 说明：控制器只负责参数校验、调用 Service、格式化响应
//       业务逻辑必须在 Service 层
// ============================================================

const {{ServiceName}}Service = require('../services/{{serviceFile}}');
const { success, error } = require('../utils/response');

class {{ControllerName}}Controller {
  constructor() {
    // 依赖注入，方便测试时 mock
    this.service = new {{ServiceName}}Service();
  }

  // 列表查询接口
  // GET /api/v1/{{resourceName}}
  async list(req, res) {
    try {
      // 1. 解析分页参数
      const { page = 1, page_size = 20 } = req.query;

      // 2. 调用 Service 处理业务逻辑
      const result = await this.service.list(Number(page), Number(page_size));

      // 3. 返回统一格式响应
      return res.json(success(result));
    } catch (err) {
      return res.json(error(500, err.message));
    }
  }

  // 创建接口
  // POST /api/v1/{{resourceName}}
  async create(req, res) {
    try {
      // 1. 参数校验
      const { name, status } = req.body;
      if (!name) {
        return res.json(error(400, '名称不能为空'));
      }

      // 2. 调用 Service
      const result = await this.service.create({ name, status });

      // 3. 返回结果
      return res.json(success(result));
    } catch (err) {
      return res.json(error(500, err.message));
    }
  }
}

module.exports = {{ControllerName}}Controller;
