// ============================================================
// Service 模板（Node.js）
// 说明：业务逻辑层，所有业务规则和流程编排在此层实现
//       Controller 调 Service，Service 调 Repository/DAO
// ============================================================

const {{RepositoryName}}Repository = require('../repositories/{{repositoryFile}}');

class {{ServiceName}}Service {
  constructor(repository = new {{RepositoryName}}Repository()) {
    // 依赖注入，方便测试时 mock
    this.repository = repository;
  }

  // 列表查询
  // 返回分页数据，因为列表数据量可能很大，所以强制分页
  async list(page, pageSize) {
    // 参数默认值处理
    if (page < 1) page = 1;
    if (pageSize < 1 || pageSize > 100) pageSize = 20;

    // 调用 Repository 层查询数据
    const { list, total } = await this.repository.findAll(page, pageSize);

    return {
      total,
      page,
      page_size: pageSize,
      list,
    };
  }

  // 创建记录
  // 执行业务校验后创建新记录，校验逻辑放在 Service 层而非 Controller
  async create({ name, status }) {
    // 1. 业务规则校验（Controller 只做参数格式校验，这里做业务校验）
    const exists = await this.repository.existsByName(name);
    if (exists) {
      throw new Error(`名称已存在: ${name}`);
    }

    // 2. 持久化
    const record = await this.repository.create({ name, status });

    // 3. 返回结果
    return {
      id: record.id,
      name: record.name,
      status: record.status,
    };
  }

  // 根据 ID 查询详情
  async getById(id) {
    const record = await this.repository.findById(id);
    if (!record) {
      throw new Error('记录不存在');
    }
    return record;
  }
}

module.exports = {{ServiceName}}Service;
