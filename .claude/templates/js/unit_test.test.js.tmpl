// ============================================================
// 单元测试模板（Node.js + Jest）
// 说明：覆盖正常场景、异常场景、边界条件
//       外部依赖使用 Mock
// ============================================================

const {{ServiceName}}Service = require('../services/{{serviceFile}}');

// Mock Repository
const mockRepository = {
  findAll: jest.fn(),
  create: jest.fn(),
  findById: jest.fn(),
  existsByName: jest.fn(),
};

describe('{{ServiceName}}Service', () => {
  let service;

  beforeEach(() => {
    jest.clearAllMocks();
    service = new {{ServiceName}}Service(mockRepository);
  });

  describe('list', () => {
    it('正常情况_分页参数合法', async () => {
      mockRepository.findAll.mockResolvedValue({
        list: [{ id: 1, name: 'test' }],
        total: 1,
      });

      const result = await service.list(1, 20);

      expect(mockRepository.findAll).toHaveBeenCalledWith(1, 20);
      expect(result.total).toBe(1);
      expect(result.list).toHaveLength(1);
    });

    it('边界情况_page为0_应自动改为1', async () => {
      mockRepository.findAll.mockResolvedValue({ list: [], total: 0 });

      await service.list(0, 20);

      expect(mockRepository.findAll).toHaveBeenCalledWith(1, 20);
    });

    it('边界情况_pageSize超过100_应限制为100', async () => {
      mockRepository.findAll.mockResolvedValue({ list: [], total: 0 });

      await service.list(1, 200);

      expect(mockRepository.findAll).toHaveBeenCalledWith(1, 100);
    });
  });

  describe('create', () => {
    it('正常情况_有效请求', async () => {
      mockRepository.existsByName.mockResolvedValue(false);
      mockRepository.create.mockResolvedValue({
        id: 1,
        name: 'test_name',
        status: 1,
      });

      const result = await service.create({ name: 'test_name', status: 1 });

      expect(result.id).toBe(1);
      expect(result.name).toBe('test_name');
    });

    it('异常情况_名称重复', async () => {
      mockRepository.existsByName.mockResolvedValue(true);

      await expect(service.create({ name: 'duplicate', status: 1 }))
        .rejects
        .toThrow('名称已存在');
    });
  });

  describe('getById', () => {
    it('正常情况_有效ID', async () => {
      mockRepository.findById.mockResolvedValue({ id: 1, name: 'test' });

      const result = await service.getById(1);

      expect(result.id).toBe(1);
    });

    it('异常情况_ID不存在', async () => {
      mockRepository.findById.mockResolvedValue(null);

      await expect(service.getById(99999))
        .rejects
        .toThrow('记录不存在');
    });
  });
});
