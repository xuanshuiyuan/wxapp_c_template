// ============================================================
// Controller 模板（Go）
// 说明：控制器只负责参数校验、调用 Service、格式化响应
//       业务逻辑必须在 Service 层
// ============================================================

package {{.PackageName}}

import (
    "github.com/kataras/iris/v12"
    "{{.ModulePath}}/internal/service/{{.ServicePackage}}"
    "{{.ModulePath}}/internal/utils"
)

// {{.Name}}Controller {{.Description}}控制器
type {{.Name}}Controller struct {
    svc *{{.ServicePackage}}.{{.Name}}Service
}

// New{{.Name}}Controller 创建控制器实例
func New{{.Name}}Controller() *{{.Name}}Controller {
    return &{{.Name}}Controller{
        svc: {{.ServicePackage}}.New{{.Name}}Service(),
    }
}

// List 列表查询接口
// GET /api/v1/{{.ResourceName}}
func (c *{{.Name}}Controller) List(ctx iris.Context) {
    // 1. 解析分页参数
    var req utils.PageRequest
    if err := ctx.ReadJSON(&req); err != nil {
        ctx.JSON(utils.Error(utils.ErrCodeInvalidParam, "参数错误"))
        return
    }

    // 2. 调用 Service 处理业务逻辑
    result, err := c.svc.List(req.Page, req.PageSize)
    if err != nil {
        ctx.JSON(utils.Error(utils.ErrCodeInternalError, err.Error()))
        return
    }

    // 3. 返回统一格式响应
    ctx.JSON(utils.Success(result))
}

// Create 创建接口
// POST /api/v1/{{.ResourceName}}
func (c *{{.Name}}Controller) Create(ctx iris.Context) {
    // 1. 解析请求参数
    var req {{.ServicePackage}}.Create{{.Name}}Request
    if err := ctx.ReadJSON(&req); err != nil {
        ctx.JSON(utils.Error(utils.ErrCodeInvalidParam, "参数错误"))
        return
    }

    // 2. 参数校验（使用 validator）
    if err := utils.Validate(req); err != nil {
        ctx.JSON(utils.Error(utils.ErrCodeInvalidParam, err.Error()))
        return
    }

    // 3. 调用 Service
    result, err := c.svc.Create(&req)
    if err != nil {
        ctx.JSON(utils.Error(utils.ErrCodeInternalError, err.Error()))
        return
    }

    // 4. 返回结果
    ctx.JSON(utils.Success(result))
}
