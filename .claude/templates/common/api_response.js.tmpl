<!-- API 响应统一封装模板（前端通用） -->
<!-- 说明：所有接口必须使用此格式返回/处理 -->
<!-- ============================================================ -->

// 统一 API 响应结构
// 所有接口都使用此结构返回，前端据此判断请求是否成功
export const CODE_SUCCESS = 0;
export const CODE_INVALID_PARAM = 400;
export const CODE_UNAUTHORIZED = 401;
export const CODE_FORBIDDEN = 403;
export const CODE_NOT_FOUND = 404;
export const CODE_INTERNAL_ERROR = 500;

// 通用错误码消息映射
export const ERROR_MESSAGES = {
  [CODE_SUCCESS]: '成功',
  [CODE_INVALID_PARAM]: '参数错误',
  [CODE_UNAUTHORIZED]: '未登录',
  [CODE_FORBIDDEN]: '无权限',
  [CODE_NOT_FOUND]: '资源不存在',
  [CODE_INTERNAL_ERROR]: '服务器内部错误',
};

/**
 * 获取错误码对应默认消息
 * @param {number} code
 * @returns {string}
 */
export function getErrorMessage(code) {
  return ERROR_MESSAGES[code] || '未知错误';
}

/**
 * 分页请求参数结构
 */
export const DEFAULT_PAGE = 1;
export const DEFAULT_PAGE_SIZE = 20;

/**
 * 标准化分页参数
 * @param {Object} params
 * @returns {Object}
 */
export function normalizePageParams(params = {}) {
  const page = Math.max(1, Number(params.page) || DEFAULT_PAGE);
  const pageSize = Math.min(100, Math.max(1, Number(params.page_size) || DEFAULT_PAGE_SIZE));
  return { page, page_size: pageSize };
}
