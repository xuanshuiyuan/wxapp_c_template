{
	"name": "wxapp_c_template",
	"version": "1.0.0",
	"private": true,
	"description": "uni-app C 端小程序模板（Vue3 + uview-plus）",
	"scripts": {
		"dev:mp-weixin": "cross-env SASS_LEGACY_JS_API=silence uni -p mp-weixin",
		"build:mp-weixin": "cross-env SASS_LEGACY_JS_API=silence uni build -p mp-weixin",
		"dev:h5": "cross-env SASS_LEGACY_JS_API=silence uni -p h5",
		"build:h5": "cross-env SASS_LEGACY_JS_API=silence uni build -p h5",
		"verify:mp-weixin": "cross-env SASS_LEGACY_JS_API=silence uni build -p mp-weixin --mode development",
		"verify:h5": "cross-env SASS_LEGACY_JS_API=silence uni build -p h5 --mode development",
		"dev:prod:mp-weixin": "cross-env SASS_LEGACY_JS_API=silence uni -p mp-weixin --mode production",
		"dev:prod:h5": "cross-env SASS_LEGACY_JS_API=silence uni -p h5 --mode production",
		"check:env": "node scripts/check-env.mjs",
		"check:refs": "node scripts/check-refs.mjs",
		"prebuild:mp-weixin": "npm run check:env",
		"prebuild:h5": "npm run check:env",
		"check:api": "node scripts/check-api.mjs",
		"check": "npm run check:refs && npm run check:api && npm run check:http",
		"check:http": "node scripts/check-http.mjs"
	},
	"dependencies": {
		"blueimp-md5": "^2.19.0",
		"vue": "^3.4.0"
	},
	"devDependencies": {
		"@dcloudio/uni-app": "3.0.0-5020620260917001",
		"@dcloudio/uni-h5": "3.0.0-5020620260917001",
		"@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
		"@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
		"cross-env": "^10.1.0",
		"sass": "^1.77.0",
		"sass-loader": "^14.0.0"
	},
	"uni-app": {
		"scripts": {}
	},
	"engines": {
		"node": ">=18"
	}
}
