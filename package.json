{
	"name": "wxapp_c_template",
	"version": "1.0.0",
	"private": true,
	"description": "uni-app C 端小程序模板（Vue3 + uview-plus）",
	"scripts": {
		"dev:mp-weixin": "SASS_LEGACY_JS_API=silence uni -p mp-weixin",
		"build:mp-weixin": "SASS_LEGACY_JS_API=silence uni build -p mp-weixin",
		"dev:h5": "SASS_LEGACY_JS_API=silence uni -p h5",
		"build:h5": "SASS_LEGACY_JS_API=silence uni build -p h5",
		"verify:mp-weixin": "SASS_LEGACY_JS_API=silence uni build -p mp-weixin --mode development",
		"verify:h5": "SASS_LEGACY_JS_API=silence uni build -p h5 --mode development",
		"dev:prod:mp-weixin": "SASS_LEGACY_JS_API=silence uni -p mp-weixin --mode production",
		"dev:prod:h5": "SASS_LEGACY_JS_API=silence uni -p h5 --mode production"
	},
	"dependencies": {
		"blueimp-md5": "^2.19.0",
		"vue": "^3.4.0"
	},
	"devDependencies": {
		"@dcloudio/uni-app": "3.0.0-5020620260917001",
		"@dcloudio/uni-h5": "3.0.0-5020620260917001",
		"@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
		"@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
		"sass": "^1.77.0",
		"sass-loader": "^14.0.0"
	},
	"uni-app": {
		"scripts": {}
	}
}