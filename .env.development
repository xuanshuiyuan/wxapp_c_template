# ── 开发环境 ──────────────────────────────────────────────
# npm run dev:* 时自动加载，优先级低于 .env.local
#
# 默认指向后端模板 go_project_template 的本地端口（其 init.sh 可改端口）。
# 后端 local/develop 环境 DevelopBypass=true：带 develop 头即跳过签名校验，
# 因此本地联调无需先配 VITE_API_KEY。

VITE_APP_ENV=development
# 小程序 / App 必须用绝对地址（微信没有 CORS 概念）
VITE_HOST_MP=http://127.0.0.1:15000/
VITE_HOST_APP=http://127.0.0.1:15000/
# H5 留空走相对路径 + manifest.h5.devServer.proxy 代理（后端未开 CORS 时直连绝对地址会被浏览器拦）
VITE_HOST_H5=
VITE_OSS_HOST=

# 跳过签名的 develop 头（生产环境必须留空 / 删除）
VITE_DEVELOP_BYPASS=develop

# 签名密钥不进 git（后端线下发放）：写在 .env.development.local（.gitignore 已忽略）